{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is a Statistic Service API for order analytics.",
        "title": "Statistic Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/statistics/masters": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get statistics for each master including orders count and revenue",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get master statistics",
                "operationId": "get-master-statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "end_date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/MasterStatistics"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {}
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {}
                    }
                }
            }
        },
        "/statistics/orders": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get overall order statistics including revenue, costs, and profit",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get order statistics",
                "operationId": "get-order-statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Master ID",
                        "name": "master_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Order status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Payment status",
                        "name": "payment_status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Payment type",
                        "name": "payment_type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "schema": {
                            "$ref": "#/definitions/OrderStatistics"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {}
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {}
                    }
                }
            }
        },
        "/statistics/payments": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get statistics grouped by payment type",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get payment statistics",
                "operationId": "get-payment-statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Master ID",
                        "name": "master_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/PaymentStatistics"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {}
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {}
                    }
                }
            }
        },
        "/statistics/revenue": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get revenue statistics grouped by period (day, week, month, year)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get revenue by period",
                "operationId": "get-revenue-by-period",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Master ID",
                        "name": "master_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "day",
                        "description": "Group by period (day, week, month, year)",
                        "name": "group_by",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/RevenueByPeriod"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {}
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {}
                    }
                }
            }
        },
        "/statistics/top-parts": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Get statistics for most used parts",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get top parts statistics",
                "operationId": "get-top-parts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date (YYYY-MM-DD)",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Master ID",
                        "name": "master_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Limit results",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/TopPartsStatistics"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {}
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {}
                    }
                }
            }
        }
    },
    "definitions": {
        "MasterStatistics": {
            "type": "object",
            "properties": {
                "average_price": {
                    "type": "number"
                },
                "completed_orders": {
                    "type": "integer"
                },
                "master_id": {
                    "type": "integer"
                },
                "master_name": {
                    "type": "string"
                },
                "total_orders": {
                    "type": "integer"
                },
                "total_revenue": {
                    "type": "number"
                }
            }
        },
        "OrderStatistics": {
            "type": "object",
            "properties": {
                "average_order_price": {
                    "description": "Средняя цена заказа",
                    "type": "number"
                },
                "cancelled_orders": {
                    "description": "Отмененные заказы",
                    "type": "integer"
                },
                "completed_orders": {
                    "description": "Завершенные заказы",
                    "type": "integer"
                },
                "in_progress_orders": {
                    "description": "Заказы в работе",
                    "type": "integer"
                },
                "paid_orders": {
                    "description": "Оплаченные заказы",
                    "type": "integer"
                },
                "total_cost": {
                    "description": "Общие расходы (order_parts.income_price)",
                    "type": "number"
                },
                "total_orders": {
                    "description": "Общее количество заказов",
                    "type": "integer"
                },
                "total_profit": {
                    "description": "Общая прибыль (revenue - cost)",
                    "type": "number"
                },
                "total_revenue": {
                    "description": "Общая выручка (orders.price)",
                    "type": "number"
                },
                "unpaid_orders": {
                    "description": "Неоплаченные заказы",
                    "type": "integer"
                }
            }
        },
        "PaymentStatistics": {
            "type": "object",
            "properties": {
                "order_count": {
                    "description": "Количество заказов",
                    "type": "integer"
                },
                "paid_count": {
                    "description": "Количество оплаченных",
                    "type": "integer"
                },
                "payment_type": {
                    "description": "Тип оплаты (cash, card, etc.)",
                    "type": "string"
                },
                "total_amount": {
                    "description": "Общая сумма",
                    "type": "number"
                },
                "unpaid_count": {
                    "description": "Количество неоплаченных",
                    "type": "integer"
                }
            }
        },
        "RevenueByPeriod": {
            "type": "object",
            "properties": {
                "cost": {
                    "description": "Расходы за период",
                    "type": "number"
                },
                "orders": {
                    "description": "Количество заказов",
                    "type": "integer"
                },
                "period": {
                    "description": "Период (дата или месяц)",
                    "type": "string"
                },
                "profit": {
                    "description": "Прибыль за период",
                    "type": "number"
                },
                "revenue": {
                    "description": "Выручка за период",
                    "type": "number"
                }
            }
        },
        "TopPartsStatistics": {
            "type": "object",
            "properties": {
                "part_id": {
                    "type": "integer"
                },
                "part_name": {
                    "type": "string"
                },
                "total_cost": {
                    "description": "Общие затраты",
                    "type": "number"
                },
                "total_profit": {
                    "description": "Общая прибыль",
                    "type": "number"
                },
                "total_revenue": {
                    "description": "Общая выручка от продаж",
                    "type": "number"
                },
                "usage_count": {
                    "description": "Количество использований",
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}